# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY                  =your_32_byte_hex_encryption_key_here
JWT_SECRET_KEY                  =your_32_byte_hex_jwt_secret_key_here
JWT_ALGORITHM                   =HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES =30

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_USER                 =60
RATE_LIMIT_API_CLIENT           =100

# ── Model API keys (server-level fallback — users can also add via vault) ─────
ANTHROPIC_API_KEY               =sk-ant-...
OPENAI_API_KEY                  =sk-...

# ── Local model endpoints ─────────────────────────────────────────────────────
LMSTUDIO_BASE_URL               =http://localhost:1234/v1
OLLAMA_BASE_URL                 =http://localhost:11434

# ── Database ──────────────────────────────────────────────────────────────────
# Use "sqlite" for zero-config local dev, "mongo" for production
DATABASE_TYPE                   =sqlite
# Required only when DATABASE_TYPE=mongo:
MONGO_URL                       =mongodb://localhost:27017
MONGO_DB_NAME                   =obsidian_any_agent
